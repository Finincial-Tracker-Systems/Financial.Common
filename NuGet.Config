<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Financial.Tracker.org" value="https://nuget.pkg.github.com/Finincial-Tracker-Systems/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <Financial.Tracker.org>
      <add key="Username" value="Finincial-Tracker-Systems" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </Financial.Tracker.org>
  </packageSourceCredentials>
</configuration>